{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && pnpm install --frozen-lockfile=false && pnpm build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "installCommand": "cd frontend && pnpm install --frozen-lockfile=false",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
